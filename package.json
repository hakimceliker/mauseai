    "react-dom": "19.1.0",
    "zod": "latest"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.39.5",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "eslint-config-next": "15.5.0",
    "husky": "^9.1.7",
    "prettier": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
