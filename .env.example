# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Inngest Configuration
INNGEST_EVENT_KEY=your-inngest-event-key

# Authentication (Phase 12+)
# For Phase 3-11 (testing): Use mock auth via headers
# x-tenant-id: the tenant UUID
# x-user-id: the user UUID
#
# For Phase 12+ (production): Use Supabase Auth with JWT tokens
AUTH_PROVIDER=mock  # Options: mock, supabase
SUPABASE_AUTH_ENABLED=false

# Application
NODE_ENV=development
AI_PROVIDER=mock

# Tenant Configuration
DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001
DEFAULT_USER_ID=00000000-0000-0000-0000-000000000001

# ===== INTEGRATION PROVIDERS =====
# All integration providers default to mock/console implementations for safety
# Real credentials should ONLY be set in .env.local (never commit to git)

# Payment Integration
# Type: stripe, square, or mock (default)
PAYMENT_PROVIDER_TYPE=mock
# PAYMENT_API_KEY=  # Add actual key in .env.local only
# PAYMENT_WEBHOOK_SECRET=  # Add actual secret in .env.local only

# Real-time/WebSocket Integration
# Currently: supabase (uses Supabase realtime)
# Future: socketio, firebase alternatives
# TODO: Add REALTIME_PROVIDER env var for switching implementations

# Notification Integration
# Type: console (default), email, slack, or multi
NOTIFICATION_TYPE=console
# EMAIL_PROVIDER_KEY=  # Add actual key in .env.local only
# SLACK_WEBHOOK_URL=  # Add actual URL in .env.local only
# SMS_API_KEY=  # Add actual key in .env.local only

# Analytics Integration
# Type: console (default), mixpanel, segment, or amplitude
ANALYTICS_TYPE=console
# ANALYTICS_API_KEY=  # Add actual key in .env.local only
# NEXT_PUBLIC_ANALYTICS_KEY=  # For client-side, can be public

# ===== A–Z REAL ADAPTERS (names only — never commit values) =====
# Production (NODE_ENV=production, also Vercel previews) never uses mocks.
# Missing settings fail closed with an explicit error; see GET /api/ops/config.

# AI providers — at least one key is required in production.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# AI_PROVIDER=            # dev/test only: "mock"; or preference: openai | anthropic
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_MODEL=claude-opus-5
# ANTHROPIC_REFUSAL_FALLBACK=on   # "off" disables the server-side refusal fallback beta
# AI_TIMEOUT_MS=25000
# AI_MAX_RETRIES=1
# OPENAI_PRICE_INPUT_CENTS_PER_1M=
# OPENAI_PRICE_OUTPUT_CENTS_PER_1M=
# ANTHROPIC_PRICE_INPUT_CENTS_PER_1M=
# ANTHROPIC_PRICE_OUTPUT_CENTS_PER_1M=

# Distributed rate limit — Upstash Redis or Vercel KV (REST). Required in production
# unless RATE_LIMIT_BACKEND=memory is set deliberately (per-instance counting).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# RATE_LIMIT_BACKEND=
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_TIMEOUT_MS=500

# Inngest signing (production)
# INNGEST_SIGNING_KEY=

# Outbound notifications (missing → deliveries recorded as channel_not_configured)
# EMAIL_PROVIDER_KEY=     # Resend API key
# EMAIL_FROM=             # e.g. "MouseAI <bildirim@alanadiniz.com>" (verified domain)
# EMAIL_API_URL=          # optional override, default https://api.resend.com/emails
# SLACK_WEBHOOK_URL=
# TEAMS_WEBHOOK_URL=

# Inbound team tools (missing → endpoint answers 503 channel_not_configured)
# SLACK_SIGNING_SECRET=
# TEAMS_OUTGOING_WEBHOOK_SECRET=  # base64 secret issued by Teams

# CRM (missing → POST /api/crm/contacts answers 503 crm_not_configured)
# CRM_API_KEY=            # HubSpot private app token
# CRM_PROVIDER=hubspot
# CRM_BASE_URL=
# CRM_TENANT_PROPERTY=    # custom contact property that stores the tenant id
# CRM_TIMEOUT_MS=10000
# CRM_MAX_RETRIES=2

# Signed ingestion webhook
# INGEST_WEBHOOK_SECRET=
