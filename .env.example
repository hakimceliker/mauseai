# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Inngest Configuration (production values belong in the approved secret store)
INNGEST_EVENT_KEY=your-inngest-event-key
# INNGEST_SIGNING_KEY=  # Required to verify Inngest webhook requests

# Authentication (Phase 12+)
# For Phase 3-11 (testing): Use mock auth via headers
# x-tenant-id: the tenant UUID
# x-user-id: the user UUID
#
# For production: Use Supabase Auth with JWT tokens
AUTH_PROVIDER=mock  # Production must explicitly use supabase
SUPABASE_AUTH_ENABLED=false  # Production: true

# Application
NODE_ENV=development
AI_PROVIDER=mock  # Production must explicitly use openai or anthropic
OPENAI_MODEL=gpt-4o-mini
# OPENAI_API_KEY=  # Add only in the approved production secret store
# ANTHROPIC_API_KEY=  # Add only in the approved production secret store
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Tenant Configuration
DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001
DEFAULT_USER_ID=00000000-0000-0000-0000-000000000001

# ===== INTEGRATION PROVIDERS =====
# All integration providers default to mock/console implementations for safety
# Real credentials should ONLY be set in .env.local (never commit to git)

# Payment Integration
# Type: stripe, square, or mock (default)
PAYMENT_PROVIDER_TYPE=mock
# PAYMENT_API_KEY=  # Add actual key in .env.local only
# PAYMENT_WEBHOOK_SECRET=  # Add actual secret in .env.local only

# Real-time/WebSocket Integration
# The provider uses only the public Supabase URL/key on the client.
REALTIME_PROVIDER=supabase

# Notification Integration
# Type: console (default), email, slack, or multi
NOTIFICATION_TYPE=console
# RESEND_API_KEY=  # Add only in the approved production secret store
# EMAIL_FROM=  # Verified sender address; not a secret
# EMAIL_PROVIDER_KEY=  # Legacy alias; prefer RESEND_API_KEY
# SLACK_WEBHOOK_URL=  # Add actual URL in .env.local only
# SMS_API_KEY=  # Add actual key in .env.local only

# Analytics Integration
# Type: console (default), mixpanel, segment, or amplitude
ANALYTICS_TYPE=console
# ANALYTICS_API_KEY=  # Add actual key in .env.local only
# NEXT_PUBLIC_ANALYTICS_KEY=  # For client-side, can be public
# POSTHOG_TIMEOUT_MS=3000  # Bounded server-side analytics transport timeout

# Observability
# SENTRY_DSN and LANGFUSE_* belong only in the approved secret store.
# OBSERVABILITY_TIMEOUT_MS=3000  # Bounded Sentry/Langfuse transport timeout

# Local-first AI (private tunnel only; never expose Ollama :11434 publicly)
# LOCAL_AI_ENABLED=true
# LOCAL_AI_BASE_URL=https://private-tunnel-or-gateway-url
# LOCAL_AI_PROTOCOL=gateway
# LOCAL_AI_MODEL=qwen3:8b
# LOCAL_AI_CONNECT_TIMEOUT_MS=3000
# LOCAL_AI_INFERENCE_TIMEOUT_MS=45000
